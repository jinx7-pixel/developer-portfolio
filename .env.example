# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit it.

# ---- MySQL --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db

# ---- HTTP server --------------------------------------------------------
PORT=3000

# ---- Email notifications (Gmail SMTP via App Password) ------------------
# Requires a Gmail account with 2-Step Verification ON and a generated
# "App password". See README section "Gmail App Password" in this repo.
# If EMAIL_USER or EMAIL_APP_PASSWORD is empty, email sending is disabled
# but the contact form continues to save to MySQL.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_TO=jinx4784@gmail.com
